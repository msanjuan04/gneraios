{
  "name": "gnerai-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "sh scripts/with-docker.sh supabase start",
    "db:stop": "sh scripts/with-docker.sh supabase stop",
    "db:reset": "sh scripts/with-docker.sh supabase db reset",
    "db:types": "sh scripts/with-docker.sh supabase gen types typescript --local > src/lib/supabase/database.generated.ts.tmp && mv src/lib/supabase/database.generated.ts.tmp src/lib/supabase/database.generated.ts",
    "db:migrate": "sh scripts/with-docker.sh supabase migration up",
    "db:seed:demo": "sh -c 'set -e; tsx --env-file-if-exists=.env.local scripts/seed-demo.ts \"$@\"; for part in seo finance banking catalog projects; do tsx --env-file-if-exists=.env.local scripts/seed-demo-$part.ts; done' --",
    "council:evals": "tsx --env-file-if-exists=.env.local scripts/council-evals.ts",
    "prod:socios": "tsx --env-file=deploy/.env.production scripts/prod-socios.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "imapflow": "^2.2.1",
    "lucide-react": "^1.48.0",
    "mailparser": "^3.9.33",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postgres": "^3.4.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.0.9"
}
