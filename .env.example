# GNERAI OS · variables de entorno
# Copia este fichero a .env.local y rellénalo. Nunca subas .env.local al repo.
# Para entrar en la app real: completa las 3 variables SUPABASE de abajo, aplica las
# migraciones en ese proyecto y usa un usuario invitado en Supabase Auth. La preview
# no necesita claves, pero tampoco guarda datos. Reinicia `pnpm dev` tras cada cambio.
# NO pegues aquí contraseñas personales ni tokens en NEXT_PUBLIC_*: son visibles en navegador.

# --- Supabase --------------------------------------------------------------
# En local: `pnpm db:start` imprime la URL (http://127.0.0.1:54321) y las claves.
# En la nube: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…, o la anon key antigua). Va al navegador: RLS la protege.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…, o la service_role antigua). SOLO servidor: salta RLS.
# Se usa para las invitaciones, el cron diario y guardar/leer los PDFs de Storage.
SUPABASE_SECRET_KEY=
# Solo para migrar/verificar la base elegida; nunca exponer al navegador ni subir a Git.
# Copiar de Supabase → proyecto → Connect → Session pooler (o Direct si hay IPv6).
SUPABASE_DB_URL=

# --- ChatGPT Ads (estadísticas internas y campañas autorizadas en portal) ---
# Clave de Advertiser API. Solo servidor; nunca usar NEXT_PUBLIC_.
OPENAI_ADS_API_KEY=
# Slug de la organización autorizada para esta cuenta de Ads. Obligatorio si hay varias.
OPENAI_ADS_ORG_SLUG=

# --- App -------------------------------------------------------------------
# URL pública de la app (enlaces de los emails). Ajusta si arrancas en otro puerto.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto que Supabase Cron manda a POST /api/cron/daily (docs/CRON.md). Genera uno largo:
#   openssl rand -hex 32
CRON_SECRET=

# --- Email ----------------------------------------------------------------
# Resend (RESEND_API_KEY) o Brevo (BREVO_API_KEY; gnerai.com ya está verificado en Brevo), por
# HTTP. Sin ninguno, en desarrollo los emails van a Mailpit (el buzón de `supabase start`,
# http://127.0.0.1:54324) y en producción no se envía nada: ni facturas ni el «¿eres tú?» de la
# entrada con código, así que en un dispositivo nuevo no se podría entrar.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="GNERAI <facturacion@gnerai.com>"
# Opcional: otra URL de Mailpit en desarrollo.
MAILPIT_URL=

# --- SEO: Google Search Console + GA4 (módulo /seo) ---------------------------
# OAuth de Google Cloud (pantalla de consentimiento + credencial "Aplicación web"). URI de
# redirección: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra los tokens de Google en la base de datos (AES-256-GCM). Genera uno:
#   openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# --- Consejo de agentes (CONSEJO.md) -----------------------------------------
# Clave de la API de Claude (console.anthropic.com). Sin ella (ni la de Groq), el consejo no
# ejecuta a los agentes: la app enseña cómo conectarlo y el cron no encola nada. También la usa el
# lector de facturas para los PDF escaneados.
ANTHROPIC_API_KEY=

# Alternativa: Groq (console.groq.com) con un modelo abierto (GPT-OSS). Si están las dos, se usa
# Claude salvo que COUNCIL_PROVIDER=groq. GROQ_MODEL es el de lo diario y GROQ_DEEP_MODEL el del
# Chief of Staff, el cierre mensual y el abogado del diablo (por defecto, los dos openai/gpt-oss-120b).
GROQ_API_KEY=
COUNCIL_PROVIDER=
GROQ_MODEL=
GROQ_DEEP_MODEL=

# --- Notificaciones push (app instalada en el móvil o el escritorio) --------
# Claves VAPID, un par por entorno. Se generan una vez con:
#   pnpm exec web-push generate-vapid-keys
# Si se cambian, los dispositivos tienen que volver a activar los avisos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@gnerai.com

# --- Solo desarrollo -------------------------------------------------------
# /preview enseña la estructura sin base de datos ni importes inventados. En producción está apagado
# salvo que pongas esto a true.
ENABLE_UI_PREVIEW=false

# --- Backups y datos demo (opcionales) --------------------------------------
# Directorio de destino para el cron de backup. Debe existir y tener almacenamiento persistente.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Solo para scripts de datos demo locales; jamás apuntes a producción.
SEED_DATABASE_URL=

# --- Acceso -----------------------------------------------------------------
# Los socios entran con su código de 8 cifras y un dispositivo de confianza (confirmado por
# email). La verificación en dos pasos (TOTP) es opcional; con "true" se obliga a todos a
# configurarla.
AUTH_MFA_REQUIRED=
# Con "email", la primera vez que se usa un código en un dispositivo nuevo hay que confirmarlo desde
# el email del socio (y se avisa por email de cada cambio de código); necesita Resend o Brevo. Vacío:
# el código basta y el dispositivo queda como de confianza (se ve en Ajustes y avisa en la app).
AUTH_DEVICE_CONFIRMATION=

# Integraciones aún no conectadas: Holded/asesoría y Meta Ads no usan variables de
# entorno todavía. No pegues sus tokens hasta que exista un adaptador autorizado.
